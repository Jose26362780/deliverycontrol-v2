# ==============================================================================
# DELIVERYCONTROL — GUIA DE CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" na raiz do projeto e preencha suas chaves.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR E AMBIENTE
# ------------------------------------------------------------------------------
# PORT: Porta onde a API Express vai rodar (no Render é atribuída automaticamente).
PORT=3000

# NODE_ENV: Use "development" para desenvolvimento local e "production" no Render.
NODE_ENV=development

# FRONTEND_URL: URL do frontend permitida no CORS (ex: http://localhost:5173 ou seu domínio Netlify).
FRONTEND_URL=http://localhost:5173

# VITE_API_URL: URL base da API utilizada pelo frontend em desenvolvimento.
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. BANCO DE DADOS POSTGRESQL (RENDER)
# ------------------------------------------------------------------------------
# PASSO A PASSO PARA PEGAR SEU DATABASE_URL:
# 1. Acesse https://dashboard.render.com/
# 2. Clique no seu PostgreSQL criado (ex: deliverycontrol_db).
# 3. Na seção "Connections":
#    - Para rodar no seu COMPUTADOR LOCAL (VS Code / terminal):
#      Copie a "External Database URL" (ela termina em .oregon-postgres.render.com).
#    - Para configurar no RENDER (em Environment do Web Service):
#      Copie a "Internal Database URL" (ela termina em -a:5432).
# 4. Cole o link abaixo entre aspas duplas:
DATABASE_URL="postgresql://usuario:senha@host:5432/deliverycontrol_db"

# ------------------------------------------------------------------------------
# 3. SEGURANÇA E JWT (AUTENTICAÇÃO)
# ------------------------------------------------------------------------------
# PASSO A PASSO PARA GERAR UM JWT_SECRET FORTE:
# 1. Abra o terminal (PowerShell ou Bash) e execute:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Copie o hash gerado de 64 caracteres e cole abaixo:
JWT_SECRET="gere_uma_chave_secreta_aleatoria_com_o_comando_acima"
JWT_EXPIRES_IN="7d"

# BETTER_AUTH (se ativado)
BETTER_AUTH_ENABLED=true
BETTER_AUTH_SECRET="gere_outro_segredo_aleatorio_com_pelo_menos_32_caracteres"
BETTER_AUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH / OIDC (LOGIN COM GOOGLE)
# ------------------------------------------------------------------------------
# PASSO A PASSO PARA OBTER O CLIENT ID E O CLIENT SECRET NO GOOGLE:
# 1. Acesse o Google Cloud Console: https://console.cloud.google.com/
# 2. Crie um novo projeto (ex: "DeliveryControl") ou selecione um existente.
# 3. No menu lateral esquerdo, vá em "APIs e serviços" > "Tela de permissão OAuth" (OAuth consent screen):
#    - Escolha "Externo" e clique em "Criar".
#    - Preencha o nome do app ("DeliveryControl") e e-mail de suporte.
# 4. Vá em "APIs e serviços" > "Credenciais":
#    - Clique em "+ Criar credenciais" > "ID do cliente OAuth".
#    - Tipo de aplicativo: "Aplicativo da Web".
#    - Em "Origens JavaScript autorizadas", adicione:
#        http://localhost:5173
#        http://localhost:3000
#        https://seu-frontend.netlify.app (quando publicar)
#    - Em "URIs de redirecionamento autorizados", adicione:
#        http://localhost:3000/api/auth/callback/google
#        http://localhost:5173
# 5. Clique em "Criar". O Google exibirá um pop-up com seu "ID do cliente" e "Chave secreta do cliente".
# 6. Cole os valores aqui (NUNCA envie a secret para o Git ou frontend):
GOOGLE_CLIENT_ID="seu-cliente-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="sua-chave-secreta-google"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/callback/google"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (OPCIONAL / EXTRAS)
# ------------------------------------------------------------------------------
# PASSO A PASSO PARA PEGAR A CHAVE DA GEMINI API:
# 1. Acesse https://aistudio.google.com/app/apikey
# 2. Clique em "Create API Key" (Criar chave de API).
# 3. Selecione o projeto Google Cloud e copie a chave.
# 4. Cole abaixo:
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 6. REGRAS DE REPASSE PADRÃO (%)
# ------------------------------------------------------------------------------
DEFAULT_CAR_PERCENTAGE=50
DEFAULT_EMPLOYEE_A_PERCENTAGE=25
DEFAULT_EMPLOYEE_B_PERCENTAGE=25
